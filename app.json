{
  "expo": {
    "name": "Saturday",
    "slug": "saturday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "saturday",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0A0A0A"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.saturday.ai"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store"
    ],
    "autolinking": {
      "exclude": [
        "expo-camera"
      ]
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3e864573-7fe9-47fe-a72e-1270c289b268"
      }
    }
  }
}
